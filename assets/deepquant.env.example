# ═══════════════════════════════════════════════════════════════
# QuantDinger 后端 .env 模板
#
# 使用前：将 __PG_PASSWORD__ / __REDIS_PASSWORD__ / __SECRET_KEY__ / __SERVER_IP__ 替换为实际值
# 由 deploy.sh 自动渲染（首次部署时），通常无需手动编辑
# ═══════════════════════════════════════════════════════════════

# ── 品牌配置 ──
BRAND_APP_NAME=QuantDinger
BRAND_COPYRIGHT=© 2025-2026 QuantDinger. All rights reserved.

# ── 认证（必须修改）──
SECRET_KEY=__SECRET_KEY__
ADMIN_USER=quantdinger
ADMIN_PASSWORD=__ADMIN_PASSWORD__
ADMIN_EMAIL=

# ── 数据库（共享宝塔 PostgreSQL）──
DATABASE_URL=postgresql://root:__PG_PASSWORD__@localhost:5432/quantdinger
DB_TYPE=postgresql
DB_POOL_MIN=5
DB_POOL_MAX=50
DB_POOL_ACQUIRE_TIMEOUT=10
DB_POOL_HEALTH_CHECK=true

# ── Redis（共享宝塔 Redis，使用 DB 1 避免与 financial-api 冲突）──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=__REDIS_PASSWORD__
CACHE_ENABLED=true

# ── 核心应用 ──
PYTHON_API_HOST=127.0.0.1
PYTHON_API_PORT=5000
PYTHON_API_DEBUG=false
OPENAPI_ENABLED=false
RATE_LIMIT=100
ENABLE_REQUEST_LOG=true

# ── 前端 URL（CORS）──
# 域名部署用 https://域名；IP 部署用 http://IP
# deploy.env 中设置 FRONTEND_URL 覆盖此值（默认用 http://__SERVER_IP__）
FRONTEND_URL=__FRONTEND_URL__

# ── 注册 ──
ENABLE_REGISTRATION=true

# ── 数据库自动迁移 ──
SKIP_AUTO_MIGRATE=false

# ── 后台任务 ──
ENABLE_PENDING_ORDER_WORKER=true
ENABLE_PORTFOLIO_MONITOR=true

# ── Gunicorn ──
GUNICORN_WORKERS=1
GUNICORN_THREADS=8

# ── 市场执行器 ──
MARKET_EXECUTOR_WORKERS=6
PORTFOLIO_EXECUTOR_WORKERS=3

# ── 本地桌面券商（服务器上通常关闭）──
ALLOW_LOCAL_DESKTOP_BROKERS=false

# ── 代理（按需配置）──
PROXY_URL=

# ── LLM（按需配置）──
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=

# ── 策略调优 ──
STRATEGY_TICK_INTERVAL_SEC=10
GRID_STRATEGY_TICK_SEC=1
ENABLE_GRID_FILL_POLLER=true
GRID_FILL_POLL_SEC=3
PRICE_CACHE_TTL_SEC=10
K_LINE_HISTORY_GET_NUMBER=500

# ── 安全 ──
SECURITY_IP_MAX_ATTEMPTS=10
SECURITY_IP_WINDOW_MINUTES=5
SECURITY_IP_BLOCK_MINUTES=15

# ── 计费 ──
BILLING_ENABLED=false

# ── USDT 支付 ──
USDT_PAY_ENABLED=false
