# ═══════════════════════════════════════════════════════════════
# fullstack-demo Java 后端 (Spring Boot) .env 模板（示例项目）
#
# 首次部署由 deploy.sh 渲染到
#   $PROJECT_BASE/fullstack-demo/java-api/.env
# 占位符：__PG_PASSWORD__ __REDIS_PASSWORD__ __SERVER_IP__
# ═══════════════════════════════════════════════════════════════

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/demo_db
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=__PG_PASSWORD__

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=__REDIS_PASSWORD__
