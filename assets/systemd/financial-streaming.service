[Unit]
Description=__APP_NAME__ Streaming (flash_news_ws)
# 依赖真实的 PG/Redis 单元（宝塔 SysV 脚本被 systemd 包装成的 generated unit）。
# 原先写的 bt-postgresql.service / bt-redis.service 并不存在 → 顺序声明被静默忽略。
After=network-online.target pgsql.service redis.service
Wants=network-online.target pgsql.service redis.service

[Service]
Type=simple
User=root
WorkingDirectory=__PKG_DIR__
Environment=APP_ROLE=crawler
Environment=CRAWLER_ENABLED=true
ExecStart=__VENV_DIR__/bin/python -m worker.streaming
Restart=always
RestartSec=5
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=financial-streaming
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
