# ═══════════════════════════════════════════════════════════════
# official-site 构建环境变量
#
# 使用相对路径，IP/域名访问均兼容，无需按服务器分别构建
# ═══════════════════════════════════════════════════════════════

# 部署子路径（末尾斜杠不能省）
VITE_BASE_PATH=/qd/

# 在线应用 URL（QuantDinger 前端入口，相对路径）
VITE_APP_URL=/quant

# MCP Agent Gateway 基础 URL（相对路径，留空则用当前域名）
VITE_MCP_BASE_URL=
