  ],
  "servers": {
    "server-a": {
      "nginxMode": "ssl-redirect",
      "domain": "example.com",
      "wwwDomain": "www.example.com",
      "frontendUrl": "https://www.example.com"
    },
    "server-b": {
      "nginxMode": "ssl-combined",
      "domain": "example.com",
      "wwwDomain": "www.example.com",
      "frontendUrl": "https://example.com"
    }
  },
  "nginxExtras": [
    {
      "path": "/mcp",
      "type": "proxy",
      "proxyTarget": "http://127.0.0.1:7800",
      "proxyPath": "/mcp",
      "specialHeaders": true
    }
  ]
}
