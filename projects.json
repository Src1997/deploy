      },
      "build": {
        "mode": "app-package",
        "artifactPattern": "financial-api-*.tar.gz",
        "excludeDirs": [
          ".venv",
          "venv",
          "logs",
          "__pycache__",
          ".git",
          "node_modules",
          "tests",
          "docs",
          ".idea",
          ".github",
          ".vscode",
          ".mypy_cache",
          ".pytest_cache",
          ".ruff_cache",
          ".playwright-cli",
          "htmlcov",
          "*.egg-info",
          ".agents",
          ".worktrees",
          ".tmp"
        ],
        "excludeFiles": [
          "*.pyc",
          ".env",
          ".env.remoteA",
          ".env.remoteB",
          ".env.local",
          ".env.docker",
          ".env.bak.*",
          "Dockerfile",
          ".dockerignore",
          ".gitignore",
          ".gitattributes",
          ".python-version",
          "cspell.json",
          "uv.lock",
          "openapi.json",
          "test_results.txt",
          ".coverage",
          "AGENTS.md",
          "AGENTS.zh-CN.md",
          "nohup.out",
          "pytest.ini",
          "railway.json",
          "requirements-windows.txt",
          "docker-entrypoint.sh",
          "env.testnet.example",
          "start.sh",
          "_diag_net.py",
          "_diag_nosub.py",
          "LICENSE",
          "RELEASE.md",
          "*.bak.*"
        ],
        "keyFiles": [
          "configs/systemd/financial-api.service",
          "configs/systemd/financial-crawler.service",
          "configs/systemd/financial-worker.service",
          "configs/systemd/financial-streaming.service"
        ],
        "includeFiles": [
          "scripts/deploy-financial-api.sh",
          "configs/financial-api.env.example"
        ],
        "includeEnv": [
          "configs/financial-api.env"
        ],
        "extraSources": []
      }
    },
    {
      "id": "demo-react-web",
      "project": "fullstack-demo",
      "enabled": true,
      "kind": "frontend",
      "displayName": "React 前端 (npm)",
      "sourcePath": "fullstack-demo/frontend",
      "publicUrl": "/",
      "deployPath": "fullstack-demo/web/dist",
      "services": [],
