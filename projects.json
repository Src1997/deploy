        "artifact": "demo-react-web-dist.tar.gz"
      }
    },
    {
      "id": "demo-java-api",
      "project": "fullstack-demo",
      "enabled": true,
      "kind": "java",
      "displayName": "Java API (Maven)",
      "sourcePath": "fullstack-demo/java-backend",
      "publicUrl": "",
      "deployPath": "fullstack-demo/java-api",
      "services": [
        "fullstack-demo-java"
      ],
      "healthUrl": "http://127.0.0.1:8080/actuator/health",
      "nginxReload": false,
      "deployHook": "",
      "nginx": {
        "locations": [
          {
            "path": "/java-api/",
            "type": "proxy",
            "proxyTarget": "http://127.0.0.1:8080",
            "proxyPath": "/api/"
          }
        ]
      },
      "build": {
        "buildTool": "maven",
        "jarDir": "target",
        "artifactPattern": "demo-java-api-*.tar.gz",
        "includeFiles": [
          "configs/fullstack-demo-java.env.example"
        ],
        "includeEnv": [
          "configs/fullstack-demo-java.env"
        ],
        "keyFiles": [
          "configs/systemd/fullstack-demo.service"
        ],
        "jarPattern": "demo-api-*.jar"
      }
    },
    {
      "id": "demo-go-api",
      "project": "fullstack-demo",
      "enabled": true,
      "kind": "go",
      "displayName": "Go API (Gin)",
      "sourcePath": "fullstack-demo/go-backend",
      "publicUrl": "",
      "deployPath": "fullstack-demo/go-api",
      "services": [
        "fullstack-demo-go"
      ],
      "healthUrl": "http://127.0.0.1:8081/health",
      "nginxReload": false,
      "deployHook": "",
      "nginx": {
        "locations": [
          {
            "path": "/go-api/",
            "type": "proxy",
            "proxyTarget": "http://127.0.0.1:8081",
            "proxyPath": "/api/"
          }
        ]
      },
      "build": {
        "buildCommand": "$env:GOOS='linux'; $env:GOARCH='amd64'; go build -o demo-go-api ./cmd/server",
        "artifactPattern": "demo-go-api-*.tar.gz",
        "includeFiles": [
          "configs/fullstack-demo-go.env.example"
        ],
        "includeEnv": [
          "configs/fullstack-demo-go.env"
        ],
        "keyFiles": [
          "configs/systemd/fullstack-demo.service"
        ],
        "binaryName": "demo-go-api"
      }
    },
    {
