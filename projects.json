{
  "version": 1,
  "workspaceRoot": "",
  "projectBase": "/www/wwwroot/project",
  "projects": [
    {
      "id": "deepquant-web",
      "project": "deepquant",
      "enabled": true,
      "kind": "frontend",
      "displayName": "QuantDinger 前端",
      "sourcePath": "deepquant/deepquant_vue",
      "publicUrl": "/quant/",
      "deployPath": "deepquant/web/dist",
      "services": [],
      "healthUrl": "",
      "nginxReload": true,
      "deployHook": "",
      "nginx": {
        "locations": [
          {
            "path": "/quant/",
            "type": "static",
            "spaFallback": true
          }
        ]
      },
      "build": {
        "packageManager": "pnpm",
        "script": "build",
        "distDir": "dist",
        "artifact": "deepquant-web-dist.tar.gz"
      }
    },
    {
      "id": "deepquant-backend",
      "project": "deepquant",
      "enabled": true,
      "kind": "python",
      "displayName": "QuantDinger 后端",
      "sourcePath": "deepquant/deepquant/backend_api_python",
      "publicUrl": "",
      "deployPath": "deepquant/backend/package",
      "services": [
        "quantdinger-backend",
        "quantdinger-mcp"
      ],
      "healthUrl": "http://127.0.0.1:5000/api/health",
      "nginxReload": false,
      "deployHook": "",
      "nginx": {
        "locations": [
          {
            "path": "/quant/api/",
            "type": "proxy",
            "proxyTarget": "http://127.0.0.1:5000",
            "proxyPath": "/api/"
          },
          {
            "path": "/ws/",
            "type": "websocket",
            "proxyTarget": "http://127.0.0.1:5000",
            "proxyPath": "/ws/"
          }
        ]
      },
      "build": {
        "mode": "source-tar",
        "artifactPattern": "deepquant-backend-*.tar.gz",
        "excludeDirs": [
          ".venv",
          "venv",
          "logs",
          "__pycache__",
          ".git",
          "node_modules",
          "tests",
          "docs",
          ".idea",
          ".github",
          ".vscode",
          ".mypy_cache",
          ".pytest_cache",
          ".ruff_cache",
          ".playwright-cli",
          "htmlcov",
          "*.egg-info",
          ".agents",
          ".worktrees",
          ".tmp"
        ],
        "excludeFiles": [
          "*.pyc",
          ".env",
          ".env.remoteA",
          ".env.remoteB",
          ".env.local",
          ".env.docker",
          ".env.bak.*",
          "Dockerfile",
          ".dockerignore",
          ".gitignore",
          ".gitattributes",
          ".python-version",
          "cspell.json",
          "uv.lock",
          "openapi.json",
          "test_results.txt",
          ".coverage",
          "AGENTS.md",
          "AGENTS.zh-CN.md",
          "nohup.out",
          "pytest.ini",
          "railway.json",
          "requirements-windows.txt",
          "docker-entrypoint.sh",
          "env.testnet.example",
          "start.sh",
          "_diag_net.py",
          "_diag_nosub.py",
          "LICENSE",
          "RELEASE.md",
          "*.bak.*"
        ],
        "keyFiles": [
          "configs/systemd/quantdinger-backend.service",
          "configs/systemd/quantdinger-mcp.service"
        ],
        "includeFiles": [
          "configs/deepquant.env.example"
        ],
        "includeEnv": [
          "configs/deepquant.env"
        ],
        "extraSources": [
          {
            "path": "deepquant/deepquant/mcp_server",
            "dest": "mcp_server"
          }
        ]
      }
    },
    {
      "id": "financial-web",
