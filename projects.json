      "sourcePath": "fullstack-demo/nodejs-backend",
      "publicUrl": "",
      "deployPath": "fullstack-demo/nodejs-api",
      "services": [
        "fullstack-demo-nodejs"
      ],
      "healthUrl": "http://127.0.0.1:8082/health",
