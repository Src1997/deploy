# ═══════════════════════════════════════════════════════════════
# deploy.env — 部署配置模板
#
# 使用方法：
#   cp deploy.env.example deploy.env
#   编辑 deploy.env，把 CHANGE_ME 换成真实密码
#
# ⚠️ deploy.env 禁止提交到 Git（已在 .gitignore）
# 服务器建议路径：/www/wwwroot/project/deploy.env
# 或上传到 dist 同级后: export DEPLOY_ENV_FILE=/path/to/deploy.env
# ═══════════════════════════════════════════════════════════════

# ── 工作空间（本地 build.ps1 用，服务器端可留空）──
WORKSPACE_ROOT=

# ── 项目基路径（服务器端）──
PROJECT_BASE=/www/wwwroot/project

# ── PostgreSQL（宝塔实例，仅本机）──
PG_USER=root
PG_PASSWORD=CHANGE_ME
PG_HOST=localhost
PG_PORT=5432

# ── Redis（宝塔实例，仅本机）──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ── QuantDinger 首次 .env 用（可选；留 CHANGE_ME 则部署时随机生成）──
ADMIN_PASSWORD=CHANGE_ME

# ── SMTP（宝塔邮局，financial-api 邮箱验证码用）──
# 宝塔面板 → 软件商店 → 邮局，创建 noreply@你的域名 账号
SMTP_PASSWORD=CHANGE_ME

# ── 域名（SSL 部署用，deploy.sh 渲染 nginx 配置占位符）──
# 留空则使用 IP 部署（无 SSL）
# DOMAIN=example.com
# WWW_DOMAIN=www.example.com

# ── 应用名称（邮件显示名等）──
APP_NAME=MyApp

# ── QuantDinger 前端 URL（域名部署用 https://域名，IP 部署用 http://IP）──
# 留空则默认 http://__SERVER_IP__
# FRONTEND_URL=https://your-domain.com

# ── 备份 ──
BACKUP_BASE=
MAX_BACKUPS=5

# ── 部署锁 / 审计 ──
LOCK_FILE=/tmp/deploy.lock
DEPLOY_LOG=

# ── dist / configs（一般可留空，脚本按 PROJECT_BASE 推导）──
DIST_ROOT=
PACKAGES_DIR=
CONFIGS_SRC=

# ── Nginx（deploy.sh --nginx）──
NGINX_CONF_TARGET=/www/server/panel/vhost/nginx/default.conf
# 选择 Nginx 配置文件名（默认 nginx-all-sites.conf）
# 域名+SSL：nginx-servera-ssl.conf（服务器 A）/ nginx-all-sites-ssl.conf（服务器 B）
# NGINX_CONF_NAME=nginx-servera-ssl.conf

# ── 干跑（WSL 沙箱 / 测试）──
DEPLOY_DRY_RUN=0
