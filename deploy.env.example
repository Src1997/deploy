# ═══════════════════════════════════════════════════════════════
# deploy.env — 本地/虚拟机部署配置模板
#
# 使用方法：
#   cp deploy.env.example deploy.env
#   编辑 deploy.env，把 CHANGE_ME 换成真实密码
#
# 三套环境模板：
#   deploy.env.example          → 本地/虚拟机（本文件）
#   deploy.env.server-a.example → 服务器 A（ssl-redirect，裸域→www）
#   deploy.env.server-b.example → 服务器 B（ssl-combined，域名合并）
#
# 服务器端切换环境：
#   bash deploy.sh financial-web --target=server-a
#   或：DEPLOY_TARGET=server-b bash deploy.sh all --yes
#
# ⚠️ deploy.env* 禁止提交到 Git（已在 .gitignore）
# 服务器建议路径：/www/wwwroot/project/deploy.env
# 或上传到 dist 同级后: export DEPLOY_ENV_FILE=/path/to/deploy.env
# ═══════════════════════════════════════════════════════════════

# ── 工作空间（本地 build.ps1 用，服务器端可留空）──
# 留空则自动用 deploy 父目录；也可指向其他工作区根（如 D:\Projects）
WORKSPACE_ROOT=

# ── 项目基路径（服务器端）──
PROJECT_BASE=/www/wwwroot/project

# ── 项目清单 SSOT（可选覆盖）──
# 默认: deploy/projects.json
# 由 project-configs/*.toml 自动生成: python3 scripts/sync-manifest.py
# PROJECTS_FILE=/path/to/projects.json

# ── PostgreSQL（宝塔实例）──
PG_USER=root
PG_PASSWORD=CHANGE_ME
PG_HOST=localhost
PG_PORT=5432

# ── Redis（宝塔实例）──
# 本地/虚拟机：填写宝塔 Redis 密码；无密码则留空（REDIS_PASSWORD=）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ── QuantDinger 首次 .env 用（可选；留 CHANGE_ME 则部署时随机生成）──
ADMIN_PASSWORD=CHANGE_ME

# ── SMTP（宝塔邮局，financial-api 邮箱验证码用）──
# 宝塔面板 → 软件商店 → 邮局，创建 noreply@你的域名 账号
SMTP_PASSWORD=CHANGE_ME

# ── 域名（本地/虚拟机通常留空，使用 IP 部署）──
# 留空则使用 IP 部署（无 SSL）
DOMAIN=
WWW_DOMAIN=

# ── 应用名称（邮件显示名等）──
APP_NAME=MyApp

# ── QuantDinger 前端 URL（IP 部署用 http://IP，域名部署用 https://域名）──
# 留空则默认 http://__SERVER_IP__
FRONTEND_URL=

# ── 备份 ──
BACKUP_BASE=
MAX_BACKUPS=5

# ── 部署锁 / 审计 ──
LOCK_FILE=/tmp/deploy.lock
DEPLOY_LOG=

# ── dist / configs（一般可留空，脚本按 PROJECT_BASE 推导）──
DIST_ROOT=
PACKAGES_DIR=
CONFIGS_SRC=

# ── Nginx（deploy.sh --nginx）──
NGINX_CONF_TARGET=/www/server/panel/vhost/nginx/default.conf
# Nginx 配置模式（动态生成，不再依赖预写文件）
# http:           无 SSL（IP 部署，本地默认）
# ssl-redirect:   裸域→www 301 + HTTPS（服务器 A）
# ssl-combined:   域名+HTTPS 合并配置（服务器 B）
NGINX_CONF_NAME=

# ── MCP（quantdinger-mcp 服务鉴权令牌）──
# 缺失时该服务无法启动，deploy.sh 仅告警不阻断；请替换为强随机串。
MCP_AGENT_TOKEN=CHANGE_ME

# ── 干跑（WSL 沙箱 / 测试）──
DEPLOY_DRY_RUN=0
