# ═══════════════════════════════════════════════════════════════
# deploy.env.server-a — 服务器 A 配置模板（ssl-redirect：裸域→www 301）
#
# 使用方法：
#   cp deploy.env.server-a.example deploy.env.server-a
#   编辑 deploy.env.server-a，把 CHANGE_ME 换成真实密码
#
# 服务器端部署时指定环境：
#   bash deploy.sh financial-web --target=server-a
#   或：DEPLOY_TARGET=server-a bash deploy.sh all --yes
#
# ⚠️ deploy.env.server-a 禁止提交到 Git（已在 .gitignore）
# 服务器建议路径：/www/wwwroot/project/deploy.env.server-a
# ═══════════════════════════════════════════════════════════════

# ── 工作空间（服务器端留空）──
WORKSPACE_ROOT=

# ── 项目基路径 ──
PROJECT_BASE=/www/wwwroot/project

# ── PostgreSQL（宝塔实例）──
PG_USER=root
PG_PASSWORD=CHANGE_ME
PG_HOST=localhost
PG_PORT=5432

# ── Redis（服务器 A：需要密码）──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ── QuantDinger 首次 .env 用 ──
ADMIN_PASSWORD=CHANGE_ME

# ── SMTP（宝塔邮局）──
SMTP_PASSWORD=CHANGE_ME

# ── 域名（服务器 A：裸域 + www，SSL 走 ssl-redirect）──
DOMAIN=example.com
WWW_DOMAIN=www.example.com

# ── 应用名称 ──
APP_NAME=MyApp

# ── 前端 URL（服务器 A：www 域名）──
FRONTEND_URL=https://www.example.com

# ── 备份 ──
BACKUP_BASE=
MAX_BACKUPS=5

# ── 部署锁 / 审计 ──
LOCK_FILE=/tmp/deploy.lock
DEPLOY_LOG=

# ── dist / configs ──
DIST_ROOT=
PACKAGES_DIR=
CONFIGS_SRC=

# ── Nginx（服务器 A：ssl-redirect 模式）──
NGINX_CONF_TARGET=/www/server/panel/vhost/nginx/default.conf
# nginx-servera-ssl → ssl-redirect（裸域→www 301 + HTTPS）
NGINX_CONF_NAME=nginx-servera-ssl.conf

# ── MCP ──
MCP_AGENT_TOKEN=CHANGE_ME

# ── 干跑（服务器端正常部署时为 0）──
DEPLOY_DRY_RUN=0
