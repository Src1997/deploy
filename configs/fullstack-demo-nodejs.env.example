# ═══════════════════════════════════════════════════════════════
# fullstack-demo Node.js 后端 (NestJS) .env 模板（示例项目）
#
# 首次部署由 deploy.sh 渲染到
#   $PROJECT_BASE/fullstack-demo/nodejs-api/.env
# 占位符：__PG_PASSWORD__ __REDIS_PASSWORD__ __SERVER_IP__
# ═══════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=8082

DATABASE_URL=postgresql://root:__PG_PASSWORD__@localhost:5432/demo_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=__REDIS_PASSWORD__
