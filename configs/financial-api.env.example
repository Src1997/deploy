# ═══════════════════════════════════════════════════════════════
# financial-api .env 模板
#
# 首次部署由 deploy-financial-api.sh / deploy.sh 渲染到
#   $PROJECT_BASE/financial/financial-api/package/.env
# 占位符：__PG_PASSWORD__ __REDIS_PASSWORD__ __AUTH_SECRET_KEY__ __WEB_PATH__ __SERVER_IP__
# ═══════════════════════════════════════════════════════════════

APP_NAME=financial-api
APP_ENV=production
DEBUG=false
APP_ROLE=api

HOST=127.0.0.1
PORT=5001

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_PASSWORD=__PG_PASSWORD__
POSTGRES_DB=quant_zc
DATABASE_URL=postgresql+psycopg2://root:__PG_PASSWORD__@localhost:5432/quant_zc

REDIS_ENABLED=true
REDIS_URL=redis://:__REDIS_PASSWORD__@localhost:6379/0
# arq 队列使用独立 DB index /1，与 realtime pub/sub (/0) 隔离
ARQ_REDIS_URL=redis://:__REDIS_PASSWORD__@localhost:6379/1

REALTIME_ENABLED=true
TICK_SIMULATOR_ENABLED=true

AUTH_MODE=local
AUTH_SECRET_KEY=__AUTH_SECRET_KEY__
AUTH_UPSTREAM_URL=http://127.0.0.1:5000
AUTH_UPSTREAM_TIMEOUT=30
AUTH_CACHE_TTL=60

# CORS：域名部署自动渲染 https://__WWW_DOMAIN__,https://__DOMAIN__
# IP 部署用 http://__SERVER_IP__
CORS_ORIGINS=https://__WWW_DOMAIN__,https://__DOMAIN__,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://__SERVER_IP__

RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=60

CRAWLER_ENABLED=true
CRAWLER_FASTBULL_API_BASE=https://api.fastbull.com
CRAWLER_FASTBULL_SITE_BASE=https://www.fastbull.com
CRAWLER_FASTBULL_LANG_ID=1
CRAWLER_FASTBULL_FLASH_NEWS_TAGS=176,155,170,121
CRAWLER_REQUEST_INTERVAL_SEC=2.0
CRAWLER_HTTP_TIMEOUT_SEC=60
CRAWLER_MAX_RETRIES=5
CRAWLER_BROADCAST_FLASH_NEWS=true
CRAWLER_FLASH_NEWS_MAX_PAGES=3

LOG_JSON=false
LOG_TO_FILE=true
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_UVICORN_ACCESS_LEVEL=WARNING

WEB_PATH=__WEB_PATH__

# ── 数据库 Seed 安全开关 ──
# SKIP_SEED_PURGE=true：生产环境跳过 purge_obsolete / DELETE，只做增量插入
#   防止 seed 清除 Admin 面板编辑过的运行时数据（导航节点、AppConfig 等）
SKIP_SEED_PURGE=true
# SKIP_AUTO_MIGRATE=true：跳过应用启动时的自动 Alembic 迁移
#   适用于运维自行管理 schema 的场景（默认不设 = 每次启动自动迁移）
# SKIP_AUTO_MIGRATE=false

# ── SMTP 邮箱验证码 ──
# 方法一（默认）：宝塔邮局自建（Postfix + Dovecot + Rspamd）
#   SMTP_HOST=127.0.0.1  SMTP_PORT=465  SMTP_USE_TLS=false
# 方法二：第三方 SMTP 服务（改下面配置即可）
#   QQ企业邮箱:  smtp.exmail.qq.com  465  false
#   Gmail:       smtp.gmail.com      587  true
#   阿里云邮箱:   smtp.qiye.aliyun.com 465  false
#   网易163企业:  smtp.qiye.163.com   994  false
# deploy.env 中填 SMTP_PASSWORD（宝塔邮局为邮箱账号密码，第三方为授权码）
SMTP_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=465
SMTP_USERNAME=noreply@__DOMAIN__
SMTP_PASSWORD=__SMTP_PASSWORD__
# SMTP_USE_TLS=false → SMTP_SSL（端口 465）；true → STARTTLS（端口 587）
SMTP_USE_TLS=false
SMTP_FROM_ADDR=noreply@__DOMAIN__
SMTP_FROM_NAME=__APP_NAME__
# 邮件主题模板（{code} 占位符替换为验证码）
EMAIL_SUBJECT_TEMPLATE=您的验证码 - __APP_NAME__
# 邮件正文模板：留空使用代码默认模板（含 {code} 占位符）
# 注意：env 中的 \n 是字面字符不是换行，如需自定义正文请在代码中修改 DEFAULT_BODY_TEMPLATE
# EMAIL_BODY_TEMPLATE=
