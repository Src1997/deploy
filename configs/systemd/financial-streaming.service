[Unit]
Description=__APP_NAME__ Streaming (flash_news_ws)
After=network.target bt-postgresql.service bt-redis.service
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=__PKG_DIR__
Environment=APP_ROLE=crawler
Environment=CRAWLER_ENABLED=true
ExecStart=__VENV_DIR__/bin/python -m worker.streaming
Restart=always
RestartSec=5
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=financial-streaming
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
