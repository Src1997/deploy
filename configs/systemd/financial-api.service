[Unit]
Description=__APP_NAME__ API Server
After=network.target bt-postgresql.service bt-redis.service
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=__PKG_DIR__
Environment=APP_ROLE=api
ExecStart=__VENV_DIR__/bin/uvicorn app.main:app --host 127.0.0.1 --port __API_PORT__ --no-access-log
Restart=always
RestartSec=5
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=financial-api
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
