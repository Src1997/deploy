[Unit]
Description=QuantDinger MCP Server (SSE on port 7800)
After=network-online.target quantdinger-backend.service
Wants=network-online.target quantdinger-backend.service

[Service]
Type=simple
User=root
WorkingDirectory=/www/wwwroot/project/deepquant/backend/package
Environment=QUANTDINGER_MCP_TRANSPORT=sse
# v5 mcp_server 拒绝「非回环地址 + 无鉴权」的 HTTP 绑定；nginx 在本机把 /mcp
# 反代到 7800，绑定回环即可，无需暴露公网（也免去 QUANTDINGER_MCP_AUTH_TOKEN 配置）。
Environment=QUANTDINGER_MCP_HOST=127.0.0.1
Environment=QUANTDINGER_MCP_PORT=7800
Environment=QUANTDINGER_BASE_URL=http://127.0.0.1:5000
Environment=QUANTDINGER_AGENT_TOKEN=__MCP_AGENT_TOKEN__
Environment=PYTHONUNBUFFERED=1
ExecStart=/www/wwwroot/project/deepquant/backend/package/.venv/bin/python -m quantdinger_mcp.server
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=quantdinger-mcp

[Install]
WantedBy=multi-user.target
