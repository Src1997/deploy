[Unit]
Description=__APP_NAME__ Crawler Enqueue Scheduler
After=network.target bt-postgresql.service bt-redis.service
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=__PKG_DIR__
Environment=APP_ROLE=crawler
Environment=CRAWLER_ENABLED=true
Environment=CRAWLER_ENQUEUE_ENABLED=true
ExecStart=__VENV_DIR__/bin/python -m app.crawler scheduler
Restart=always
RestartSec=5
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=financial-crawler
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
