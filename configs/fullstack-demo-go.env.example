# ═══════════════════════════════════════════════════════════════
# fullstack-demo Go 后端 (Gin) .env 模板（示例项目）
#
# 首次部署由 deploy.sh 渲染到
#   $PROJECT_BASE/fullstack-demo/go-api/.env
# 占位符：__PG_PASSWORD__ __REDIS_PASSWORD__ __SERVER_IP__
# ═══════════════════════════════════════════════════════════════

GIN_MODE=release
PORT=8081

DATABASE_URL=postgresql://root:__PG_PASSWORD__@localhost:5432/demo_db?sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=__REDIS_PASSWORD__
