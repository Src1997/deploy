# 构建产物（dist/ 下全部由 build.ps1 生成，源文件在 scripts/ 和 configs/）
dist/

# 本地/服务器真实密码（禁止提交）
# deploy.env          → 本地
# deploy.env.vm       → 虚拟机
# deploy.env.server-a → 服务器 A
# deploy.env.server-b → 服务器 B
# deploy.env.server-c → 服务器 C（zhouchou.net，2026-10-16 新增）
deploy.env
deploy.env.vm
deploy.env.server-a
deploy.env.server-b
# 通配所有服务器环境文件（含明文密码，永不提交）
deploy.env.server-*

# 数据库 dump（本地导出，不提交）
scripts/dumps/

# Python 缓存
__pycache__/
*.pyc

# 临时文件（网络配置等）
tmp/

# 脚本临时产物（openapi 导出等）
scripts/openapi_tmp.json

# deploy.env 的本地备份（含明文密码，永不提交）
deploy.env.*.bak_*
